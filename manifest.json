{
  "manifest_version": 3,
  "name": "Prompt Helper Gemini",
  "short_name": "Prompt Helper Gemini",
  "version": "2.3.1",
  "description": "Intelligent prompt refinement for AI chats. Enhance Text, Code, Image, and Video prompts with one click.",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "1097186279139-00aqbna3di7fch3m5mbvov2824lri3bq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://claude.ai/*",
    "https://console.anthropic.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api-clyep56cdq-uc.a.run.app/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup-extension.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://claude.ai/*",
        "https://console.anthropic.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "enhance-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Enhance current prompt"
    }
  }
}